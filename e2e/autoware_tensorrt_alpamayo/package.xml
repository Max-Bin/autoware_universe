<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>autoware_tensorrt_alpamayo</name>
  <version>0.1.0</version>
  <description>
    End-to-end trajectory planner using Alpamayo (VLM + expert diffusion denoiser).
    PyTorch BF16 VLM + TRT FP16 Expert, optimized for RTX PRO 6000 (~561ms/inference).
  </description>
  <maintainer email="bin.wang@tier4.jp">binwang</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>autoware_planning_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>

  <test_depend>ament_pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
